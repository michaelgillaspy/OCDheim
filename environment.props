<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
   <!-- Needs to be your path to the base Valheim folder (for the Managed/ game assemblies) -->
    <VALHEIM_INSTALL>C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>
    <!-- BepInEx core folder (0Harmony.dll, MonoMod, etc). Override this if you run mods through
         r2modman/Thunderstore Mod Manager, whose BepInEx lives in a separate profile folder
         instead of the Valheim install directory, e.g.:
         C:\Users\<you>\AppData\Roaming\r2modmanPlus-local\Valheim\profiles\<Profile>\BepInEx -->
    <BEPINEX_INSTALL>$(VALHEIM_INSTALL)\BepInEx</BEPINEX_INSTALL>
    <!-- This is the folder where your build gets copied to when using the post-build automations -->
    <MOD_DEPLOYPATH>$(BEPINEX_INSTALL)\plugins</MOD_DEPLOYPATH>
  </PropertyGroup>
</Project>
